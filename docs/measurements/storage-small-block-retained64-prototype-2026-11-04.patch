+#[test]
+fn grown_external_value_retains_small_capacity_across_reopen() {
+    let memory = VectorMemory::default();
+    let mut tree = Tree::<u64, Vec<u8>, _>::reset(memory.clone()).unwrap();
+    tree.insert(1, vec![1; 33]).unwrap();
+    tree.insert(2, vec![2; 33]).unwrap();
+    tree.remove(&2).unwrap();
+    tree.insert(1, vec![3; 132]).unwrap();
+    let (node, index) = tree.find(&1).unwrap().unwrap();
+    let Value::External(grown) = node.value(index) else {
+        panic!()
+    };
+    assert_eq!(grown.capacity(), 256);
+    let cursor = tree.root.borrow().cursor;
+    for step in 0..12 {
+        let value = vec![4; if step % 2 == 0 { 33 } else { 132 }];
+        tree.insert(1, value.clone()).unwrap();
+        drop(tree);
+        tree = Tree::load(memory.clone()).unwrap();
+        assert_eq!(tree.get(&1).unwrap(), Some(value));
+        let (node, index) = tree.find(&1).unwrap().unwrap();
+        let Value::External(current) = node.value(index) else {
+            panic!()
+        };
+        assert_eq!(current, grown);
+        assert_eq!(tree.root.borrow().cursor, cursor);
+        check(&tree);
+    }
+}
