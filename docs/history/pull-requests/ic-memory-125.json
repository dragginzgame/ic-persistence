      "changes": 7,
      "blob_url": "https://github.com/dragginzgame/ic-memory/blob/8e36c805b7af6f9afe83a2714dbecc468dd522f1/CHANGELOG.md",
      "raw_url": "https://github.com/dragginzgame/ic-memory/raw/8e36c805b7af6f9afe83a2714dbecc468dd522f1/CHANGELOG.md",
      "contents_url": "https://api.github.com/repos/dragginzgame/ic-memory/contents/CHANGELOG.md?ref=8e36c805b7af6f9afe83a2714dbecc468dd522f1",
      "patch": "@@ -1,5 +1,12 @@\n # Changelog\n \n+## [0.49.2]\n+\n+- Use Shared's existing tool-evidence collector while retaining Memory's selected\n+  logs, redirected-parent diagnostics and hosted completeness checks.\n+\n+[Detailed notes](docs/changelog/0.49.md#0492)\n+\n ## [0.49.1] - 2026-10-19\n \n - Consume IC Platform 0.2's native PocketIC interface in installed qualification,"
    },
    {
      "sha": "9f1d355a5075078bac5c90cc7129ac4d65b0073f",
      "filename": "docs/changelog/0.49.md",
      "status": "modified",
      "additions": 10,
      "deletions": 0,
      "changes": 10,
      "blob_url": "https://github.com/dragginzgame/ic-memory/blob/8e36c805b7af6f9afe83a2714dbecc468dd522f1/docs%2Fchangelog%2F0.49.md",
      "raw_url": "https://github.com/dragginzgame/ic-memory/raw/8e36c805b7af6f9afe83a2714dbecc468dd522f1/docs%2Fchangelog%2F0.49.md",
      "contents_url": "https://api.github.com/repos/dragginzgame/ic-memory/contents/docs%2Fchangelog%2F0.49.md?ref=8e36c805b7af6f9afe83a2714dbecc468dd522f1",
      "patch": "@@ -1,5 +1,15 @@\n # 0.49 release notes\n \n+## [0.49.2]\n+\n+Use the already adopted Shared collector for tool selection, diagnostic receipts\n+and archiving. Memory keeps its log inventory, redirected-parent diagnostics,\n+archive path and hosted completeness output. Failed selector output remains\n+available as diagnostics but cannot authorize collecting external payloads.\n+The consumer fixture retains actual installer failures, archive bytes, modes,\n+links, retry isolation and hosted bindings. Library APIs and stored bytes are\n+unchanged; no snapshot refresh or tool setup change is required.\n+\n ## [0.49.1] - 2026-10-19\n \n The independent runtime qualification runner consumes published IC Platform 0.2"
    },
    {
      "sha": "bb11f16c8319748abaa85cae844f66bd773a8be4",
      "filename": "scripts/ci/collect-failure-evidence.sh",
      "status": "modified",
      "additions": 27,
      "deletions": 35,
      "changes": 62,
      "blob_url": "https://github.com/dragginzgame/ic-memory/blob/8e36c805b7af6f9afe83a2714dbecc468dd522f1/scripts%2Fci%2Fcollect-failure-evidence.sh",
      "raw_url": "https://github.com/dragginzgame/ic-memory/raw/8e36c805b7af6f9afe83a2714dbecc468dd522f1/scripts%2Fci%2Fcollect-failure-evidence.sh",
      "contents_url": "https://api.github.com/repos/dragginzgame/ic-memory/contents/scripts%2Fci%2Fcollect-failure-evidence.sh?ref=8e36c805b7af6f9afe83a2714dbecc468dd522f1",
      "patch": "@@ -1,7 +1,7 @@\n #!/usr/bin/env bash\n set -euo pipefail\n \n-# Consumer policy only: the shared helper owns archive creation and path safety.\n+# Consumer policy only: Shared owns tool selection and archive orchestration.\n [[ $# == 2 || $# == 3 ]] || { echo 'usage: collect-failure-evidence.sh TEMP-ROOT REPOSITORY-ROOT [full|compact]' >&2; exit 2; }\n mode=\"${3:-full}\"\n [[ \"$mode\" == full || \"$mode\" == compact ]] || { echo 'invalid tool evidence selection' >&2; exit 2; }\n@@ -30,18 +30,17 @@ for path in \"$temp_root/ic-memory-fixtures\" \"$temp_root/tools-setup.log\" \"$temp_\n         inputs+=(\"$temp_root\" \"${path#\"$temp_root/\"}\")\n     fi\n done\n-bundles=()\n select_tools=false\n-diagnostics=\"\"\n+local_diagnostics=\"\"\n for local_root in target .tools; do\n     if [[ -L \"$repository_root/$local_root\" ]]; then\n         # Retain the final link, never its children. Their rejection must not\n         # discard independent logs or evidence from the other physical root.\n         inputs+=(\"$repository_root\" \"$local_root\")\n         complete=false\n-        [[ -n \"$diagnostics\" ]] || diagnostics=\"$(mktemp -d \"$temp_root/tool-evidence.XXXXXX\")\"\n+        [[ -n \"$local_diagnostics\" ]] || local_diagnostics=\"$(mktemp -d \"$temp_root/local-evidence.XXXXXX\")\"\n         printf 'Evidence incomplete: %s is a symlink; retaining the link without following its target.\\n' \\\n-            \"$local_root\" >> \"$diagnostics/local-selection.log\"\n+            \"$local_root\" >> \"$local_diagnostics/local-selection.log\"\n     else\n         case \"$local_root\" in\n             target) paths=(target/qualification target/release-validation) ;;\n@@ -56,8 +55,8 @@ for local_root in target .tools; do\n                     # inadmissible leaf locally without traversing it.\n                     paths+=(.tools/rust)\n                     complete=false\n-                    [[ -n \"$diagnostics\" ]] || diagnostics=\"$(mktemp -d \"$temp_root/tool-evidence.XXXXXX\")\"\n-                    printf 'Evidence incomplete: .tools/rust is not a physical directory; retaining the leaf without following it.\\n' >> \"$diagnostics/local-selection.log\"\n+                    [[ -n \"$local_diagnostics\" ]] || local_diagnostics=\"$(mktemp -d \"$temp_root/local-evidence.XXXXXX\")\"\n+                    printf 'Evidence incomplete: .tools/rust is not a physical directory; retaining the leaf without following it.\\n' >> \"$local_diagnostics/local-selection.log\"\n                 fi\n                 ;;\n         esac\n@@ -68,36 +67,29 @@ for local_root in target .tools; do\n         done\n     fi\n done\n-if [[ -n \"$diagnostics\" ]]; then\n-    cat \"$diagnostics/local-selection.log\" >&2\n+if [[ -n \"$local_diagnostics\" ]]; then\n+    cat \"$local_diagnostics/local-selection.log\" >&2\n+    inputs+=(\"$temp_root\" \"${local_diagnostics#\"$temp_root/\"}\")\n fi\n if [[ \"$select_tools\" == true ]]; then\n-    [[ -n \"$diagnostics\" ]] || diagnostics=\"$(mktemp -d \"$temp_root/tool-evidence.XXXXXX\")\"\n-    selector=(bash \"$ROOT/scripts/ci/select-tool-evidence.sh\" \"$mode\" \"$repository_root\" \"$diagnostics\")\n-    if [[ \"$mode\" == compact ]]; then\n-        selector+=(\"$ROOT/ci/tool-versions.env\" \"$ROOT/ci/ic-tools.tsv\")\n-    fi\n-    selector_status=0\n-    \"${selector[@]}\" > \"$diagnostics/selection\" 2> \"$diagnostics/selection.log\" || selector_status=$?\n-    if [[ \"$selector_status\" != 0 ]]; then\n-        complete=false\n-        printf '%s\\n' \"$selector_status\" > \"$diagnostics/selection-status\"\n-        echo 'Tool evidence incomplete; retaining available product logs and selection diagnostics.' >&2\n-        cat \"$diagnostics/selection.log\" >&2\n-    fi\n-    while IFS= read -r -d '' selection_root && IFS= read -r -d '' selection_path; do\n-        inputs+=(\"$selection_root\" \"$selection_path\")\n-    done < \"$diagnostics/selection\"\n-fi\n-if [[ -n \"$diagnostics\" ]]; then\n-    if [[ \"$complete\" == false || -d \"$diagnostics/host\" || -d \"$diagnostics/ic\" || -s \"$diagnostics/selection.log\" ]]; then\n-        inputs+=(\"$temp_root\" \"${diagnostics#\"$temp_root/\"}\")\n-    else\n-        rm \"$diagnostics/selection\" \"$diagnostics/selection.log\"\n-        rmdir \"$diagnostics\"\n-    fi\n-fi\n-if [[ ${#inputs[@]} != 0 ]]; then\n+    diagnostics=\"$(mktemp -d \"$temp_root/tool-evidence.XXXXXX\")\"\n+    archive_dir=\"$(mktemp -d \"$temp_root/ic-memory-evidence.XXXXXX\")\"\n+    collection_status=0\n+    bash \"$ROOT/scripts/ci/collect-tool-evidence.sh\" \"$archive_dir/evidence.tar.gz\" \\\n+        \"$repository_root\" \"$diagnostics\" \"$mode\" \\\n+        \"$ROOT/ci/tool-versions.env\" \"$ROOT/ci/ic-tools.tsv\" \\\n+        ${inputs[@]+\"${inputs[@]}\"} || collection_status=$?\n+    case \"$collection_status\" in\n+        0)\n+            if [[ ! -d \"$diagnostics/host\" && ! -d \"$diagnostics/ic\" ]]; then\n+                rm \"$diagnostics/selections.nul\" \"$diagnostics/selection.log\" \\\n+                    \"$diagnostics/selection-status\" \"$diagnostics/archive-status\"\n+                rmdir \"$diagnostics\"\n+            fi ;;\n+        1) complete=false ;;\n+        *) exit \"$collection_status\" ;;\n+    esac\n+elif [[ ${#inputs[@]} != 0 ]]; then\n     archive_dir=\"$(mktemp -d \"$temp_root/ic-memory-evidence.XXXXXX\")\"\n     bash \"$ROOT/scripts/ci/archive-evidence.sh\" \"$archive_dir/evidence.tar.gz\" \"${inputs[@]}\"\n fi"
    },
    {
      "sha": "a81b5141fc9c14fec85c7ca69829b6dc7cbf0aec",
      "filename": "scripts/ci/test-failure-evidence.sh",
      "status": "modified",
      "additions": 9,
      "deletions": 7,
      "changes": 16,
      "blob_url": "https://github.com/dragginzgame/ic-memory/blob/8e36c805b7af6f9afe83a2714dbecc468dd522f1/scripts%2Fci%2Ftest-failure-evidence.sh",
      "raw_url": "https://github.com/dragginzgame/ic-memory/raw/8e36c805b7af6f9afe83a2714dbecc468dd522f1/scripts%2Fci%2Ftest-failure-evidence.sh",
      "contents_url": "https://api.github.com/repos/dragginzgame/ic-memory/contents/scripts%2Fci%2Ftest-failure-evidence.sh?ref=8e36c805b7af6f9afe83a2714dbecc468dd522f1",
      "patch": "@@ -350,39 +350,41 @@ for selection_mode in full compact; do\n                 [[ \"$member\" != \"./$alias/\"* ]] || { echo 'redirected payload must not be archived' >&2; exit 1; }\n             done < \"$redirected/members\"\n         done\n-        diagnostics=(\"$redirected/unpacked\"/tool-evidence.*/local-selection.log)\n+        diagnostics=(\"$redirected/unpacked\"/local-evidence.*/local-selection.log)\n         [[ ${#diagnostics[@]} == 1 && -s \"${diagnostics[0]}\" ]] || exit 1\n         cmp \"$redirected/error\" \"${diagnostics[0]}\"\n     done\n done\n \n-# A selector may fail after emitting admitted pairs. Retain those complete\n-# selections, its exact status/stderr and product logs; ignore a trailing root\n-# without a path. Substitute only selection, keeping the real collector/archive.\n+# A failed selector supplies diagnostics, not payload authority. Retain local\n+# tool logs and the exact status/stderr through the real shared orchestrator.\n for selection_mode in full compact; do\n     partial_root=\"$fixture/partial-selector-$selection_mode\"\n     mkdir -p \"$partial_root/scripts/ci\" \"$partial_root/temp\" \"$partial_root/repository/.tools/host-set.selected\" \\\n         \"$partial_root/unpacked\"\n-    cp \"$ROOT/scripts/ci/collect-failure-evidence.sh\" \"$ROOT/scripts/ci/archive-evidence.sh\" \"$partial_root/scripts/ci/\"\n+    cp \"$ROOT/scripts/ci/collect-failure-evidence.sh\" \"$ROOT/scripts/ci/archive-evidence.sh\" \"$ROOT/scripts/ci/collect-tool-evidence.sh\" \"$partial_root/scripts/ci/\"\n     cat > \"$partial_root/scripts/ci/select-tool-evidence.sh\" <<'SELECTOR'\n #!/usr/bin/env bash\n if [[ \"$1\" == compact ]]; then\n     snapshot_root=\"${0%/scripts/ci/select-tool-evidence.sh}\"\n     [[ \"$4\" == \"$snapshot_root/ci/tool-versions.env\" &&\n         \"$5\" == \"$snapshot_root/ci/ic-tools.tsv\" ]] || exit 18\n fi\n-printf '%s\\0%s\\0%s\\0' \"$2\" '.tools/host-set.selected' \"$2\"\n+printf '%s\\0%s\\0%s\\0' \"$IC_MEMORY_UNTRUSTED_SELECTION\" private \"$2\"\n printf 'controlled partial selector failure\\n' >&2\n exit 17\n SELECTOR\n     cp \"$temp_root/validation.log\" \"$partial_root/temp/validation.log\"\n     printf 'admitted tool diagnostics\\n' > \"$partial_root/repository/.tools/host-set.selected/install.log\"\n-    partial_archive=\"$(GITHUB_OUTPUT=\"$partial_root/outputs\" bash \"$partial_root/scripts/ci/collect-failure-evidence.sh\" \\\n+    mkdir \"$partial_root/outside\"\n+    printf 'never archive failed selections\\n' > \"$partial_root/outside/private\"\n+    partial_archive=\"$(IC_MEMORY_UNTRUSTED_SELECTION=\"$partial_root/outside\" GITHUB_OUTPUT=\"$partial_root/outputs\" bash \"$partial_root/scripts/ci/collect-failure-evidence.sh\" \\\n         \"$partial_root/temp\" \"$partial_root/repository\" \"$selection_mode\" 2> \"$partial_root/error\")\"\n     [[ -f \"$partial_archive\" && \"$(cat \"$partial_root/outputs\")\" == collection-complete=false ]] || exit 1\n     tar -xzf \"$partial_archive\" -C \"$partial_root/unpacked\"\n     cmp \"$temp_root/validation.log\" \"$partial_root/unpacked/validation.log\"\n     cmp \"$partial_root/repository/.tools/host-set.selected/install.log\" \"$partial_root/unpacked/.tools/host-set.selected/install.log\"\n+    [[ ! -e \"$partial_root/unpacked/private\" ]] || exit 1\n     statuses=(\"$partial_root/unpacked\"/tool-evidence.*/selection-status)\n     [[ ${#statuses[@]} == 1 && \"$(cat \"${statuses[0]}\")\" == 17 && \\\n         \"$(cat \"${statuses[0]%/*}/selection.log\")\" == 'controlled partial selector failure' ]] || exit 1"
    }
