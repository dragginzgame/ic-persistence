      "filename": "CHANGELOG.md",
      "status": "modified",
      "additions": 7,
      "deletions": 0,
      "changes": 7,
      "blob_url": "https://github.com/dragginzgame/ic-storage/blob/5266808e93ac20e7c4c87f4f19e9870feb27c69c/CHANGELOG.md",
      "raw_url": "https://github.com/dragginzgame/ic-storage/raw/5266808e93ac20e7c4c87f4f19e9870feb27c69c/CHANGELOG.md",
      "contents_url": "https://api.github.com/repos/dragginzgame/ic-storage/contents/CHANGELOG.md?ref=5266808e93ac20e7c4c87f4f19e9870feb27c69c",
      "patch": "@@ -1,5 +1,12 @@\n # Changelog\n \n+## [0.3.2]\n+\n+- Prepare native qualification callers for Testkit 0.51's explicit-principal\n+  calls and field-based installation inputs, preserving existing senders and\n+  reply budgets. This draft requires Testkit publication and normal dependency\n+  adoption before integration; stored product data is unchanged.\n+\n ## [0.3.1] - 2026-10-17\n \n - Remove the membership preflight from deletion. Missing-key transactions"
    },
    {
      "sha": "ebcee21e1429be10cd89b1cac8adc9f7837a1d7b",
      "filename": "crates/ic-storage-bench/src/main.rs",
      "status": "modified",
      "additions": 21,
      "deletions": 8,
      "changes": 29,
      "blob_url": "https://github.com/dragginzgame/ic-storage/blob/5266808e93ac20e7c4c87f4f19e9870feb27c69c/crates%2Fic-storage-bench%2Fsrc%2Fmain.rs",
      "raw_url": "https://github.com/dragginzgame/ic-storage/raw/5266808e93ac20e7c4c87f4f19e9870feb27c69c/crates%2Fic-storage-bench%2Fsrc%2Fmain.rs",
      "contents_url": "https://api.github.com/repos/dragginzgame/ic-storage/contents/crates%2Fic-storage-bench%2Fsrc%2Fmain.rs?ref=5266808e93ac20e7c4c87f4f19e9870feb27c69c",
      "patch": "@@ -48,7 +48,13 @@ fn main() -> Result<(), Box<dyn Error>> {\n                 let (pic, id) = fresh_canister(server.url(), &wasm, engine, profile, dense_keys)?;\n                 let mut seeded = false;\n                 for _ in 0..2048 {\n-                    if pic.update_candid::<bool, _>(id, \"seed\", (batch,), REPLY_LIMITS)? {\n+                    if pic.update_candid::<bool, _>(\n+                        id,\n+                        candid::Principal::anonymous(),\n+                        \"seed\",\n+                        (batch,),\n+                        REPLY_LIMITS,\n+                    )? {\n                         seeded = true;\n                         break;\n                     }\n@@ -95,8 +101,13 @@ fn run_workloads(server: &str, wasm: &[u8]) -> Result<(), Box<dyn Error>> {\n                 let profile = u8::try_from(fixtures::FIXTURES.len() + profile)?;\n                 let (pic, id) = fresh_canister(server, wasm, engine, profile, false)?;\n                 for batch in 0..32 {\n-                    let done =\n-                        pic.update_candid::<bool, _>(id, \"workload_seed\", (), REPLY_LIMITS)?;\n+                    let done = pic.update_candid::<bool, _>(\n+                        id,\n+                        candid::Principal::anonymous(),\n+                        \"workload_seed\",\n+                        (),\n+                        REPLY_LIMITS,\n+                    )?;\n                     assert_eq!(done, batch == 31);\n                 }\n                 for round in 0..4 {\n@@ -145,10 +156,12 @@ fn fresh_canister(\n         .with_server_url(server.parse()?)\n         .with_application_subnet()\n         .build();\n-    let id = pic.try_create_and_install(InstallSpec::new(\n-        wasm.to_vec(),\n-        candid::encode_args((engine, profile, dense_keys))?,\n-        100_000_000_000_000,\n-    ))?;\n+    let id = pic.try_create_and_install(InstallSpec {\n+        wasm: wasm.to_vec(),\n+        init_bytes: candid::encode_args((engine, profile, dense_keys))?,\n+        cycles: 100_000_000_000_000,\n+        install_sender: None,\n+        label: None,\n+    })?;\n     Ok((pic, id))\n }"
    }
